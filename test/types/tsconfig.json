{
  // admin-app(tsconfig.app.json)과 같은 해석 방식으로, 빌드한 dist 를 패키지 이름으로 읽는다.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": []
  },
  "files": ["consumer.tsx"]
}
