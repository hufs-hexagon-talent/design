{
  "name": "@studyroom/design",
  "version": "0.2.1",
  "private": true,
  "description": "Studyroom reservation design tokens: JS tokens, Tailwind 3 preset, MUI ThemeOptions, CSS custom properties",
  "license": "MIT",
  "repository": "github:hufs-hexagon-talent/design",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./mui": {
      "import": {
        "types": "./dist/esm/mui.d.ts",
        "default": "./dist/esm/mui.js"
      },
      "require": {
        "types": "./dist/cjs/mui.d.ts",
        "default": "./dist/cjs/mui.js"
      }
    },
    "./tailwind": {
      "types": "./dist/cjs/tailwind.d.ts",
      "default": "./dist/cjs/tailwind.js"
    },
    "./tokens.css": "./tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "mui",
    "tailwind",
    "tokens.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/clean.cjs && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.cjs",
    "test": "npm run build && vitest run && npm run test:types",
    "test:types": "tsc -p test/types/tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@mui/material": ">=7 <10"
  },
  "peerDependenciesMeta": {
    "@mui/material": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@mui/material-v7": "npm:@mui/material@7.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.30",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "2.2.2",
    "tailwindcss": "~3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
